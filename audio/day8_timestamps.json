[
  {
    "index": 0,
    "text": "We started",
    "start": 0.0,
    "end": 1.62
  },
  {
    "index": 1,
    "text": "with the factory idea:",
    "start": 1.62,
    "end": 3.2
  },
  {
    "index": 2,
    "text": "that you could change the whole world",
    "start": 3.2,
    "end": 4.84
  },
  {
    "index": 3,
    "text": "if you had an efficient factory",
    "start": 4.84,
    "end": 6.08
  },
  {
    "index": 4,
    "text": "that could churn out change.",
    "start": 6.08,
    "end": 7.3
  },
  {
    "index": 5,
    "text": "We then went to the TV idea,",
    "start": 7.84,
    "end": 9.8
  },
  {
    "index": 6,
    "text": "that said",
    "start": 9.8,
    "end": 10.3
  },
  {
    "index": 7,
    "text": "if you had a big enough mouthpiece,",
    "start": 10.3,
    "end": 11.76
  },
  {
    "index": 8,
    "text": "if you could get on TV",
    "start": 11.8,
    "end": 12.74
  },
  {
    "index": 9,
    "text": "enough times,",
    "start": 12.74,
    "end": 13.22
  },
  {
    "index": 10,
    "text": "if you could buy enough ads,",
    "start": 13.36,
    "end": 14.12
  },
  {
    "index": 11,
    "text": "you could win.",
    "start": 14.12,
    "end": 14.58
  },
  {
    "index": 12,
    "text": "And now we're in",
    "start": 15.08,
    "end": 16.4
  },
  {
    "index": 13,
    "text": "this new model of leadership,",
    "start": 16.4,
    "end": 18.52
  },
  {
    "index": 14,
    "text": "where the way we make change",
    "start": 18.52,
    "end": 21.28
  },
  {
    "index": 15,
    "text": "is not by using money or power",
    "start": 21.28,
    "end": 25.02
  },
  {
    "index": 16,
    "text": "to lever a system,",
    "start": 25.02,
    "end": 26.4
  },
  {
    "index": 17,
    "text": "but by leading.",
    "start": 27.32,
    "end": 27.98
  }
]